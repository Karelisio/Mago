<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ en thème clair : mêmes tons system_accent1/neutral1 que
     DynamicColorPlugin.kt, consommés directement en XML pour le widget (pas
     besoin de plugin ici). Le qualificatif "night" ayant priorité sur "v31"
     seul, le thème sombre a son propre fichier (widget_colors_night_v31.xml)
     plutôt que de retomber sur le repli statique. -->
<resources>
    <color name="widget_on_surface">@android:color/system_neutral1_900</color>
    <color name="widget_on_surface_variant">@android:color/system_neutral2_700</color>
    <color name="widget_gradient_start">@android:color/system_accent1_100</color>
    <color name="widget_gradient_end">@android:color/system_neutral1_10</color>
</resources>
